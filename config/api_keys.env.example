# 复制本文件为 api_keys.env 并填入你的 key（不要提交 api_keys.env 到 git）
# 至少填一个即可；填几个就跑几个模型
#
# 千问（阿里云百炼 DashScope）：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
#
# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
#
# 智谱 GLM：https://open.bigmodel.cn/
ZHIPU_API_KEY=
GLM_MODEL=glm-4-flash
